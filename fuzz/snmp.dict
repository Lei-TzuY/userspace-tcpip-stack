# ASN.1/BER primitive tags
"\x02" # INTEGER
"\x04" # OCTET STRING
"\x05" # NULL
"\x06" # OBJECT IDENTIFIER
"\x30" # SEQUENCE
"\x40" # IpAddress
"\x41" # Counter32
"\x42" # Gauge32
"\x43" # TimeTicks
"\x46" # Counter64

# SNMP PDU tags
"\xa0" # GetRequest
"\xa1" # GetNextRequest
"\xa2" # GetResponse
"\xa3" # SetRequest
"\xa5" # GetBulkRequest

# BER length boundaries
"\x00"
"\x7f"
"\x81\x80"
"\x81\xff"
"\x82\x01\x00"
"\x82\x10\x00"

# SNMP versions and common communities
"\x02\x01\x00" # v1
"\x02\x01\x01" # v2c
"public"
"private"

# Common OID encodings
"\x06\x08\x2b\x06\x01\x02\x01\x01\x01\x00" # sysDescr.0
"\x06\x08\x2b\x06\x01\x02\x01\x01\x05\x00" # sysName.0
